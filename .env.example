# Copiez ce fichier en ".env" puis adaptez les valeurs.
# Numéro WhatsApp de la boutique : indicatif pays + numéro, sans "+" ni espaces.
VITE_WHATSAPP_NUMBER=22900000000

# Code d'accès de l'espace admin (démo locale uniquement, NON sécurisé).
# Pour un vrai site en ligne, utilisez Supabase Auth (voir README).
VITE_ADMIN_PASSCODE=admin123
